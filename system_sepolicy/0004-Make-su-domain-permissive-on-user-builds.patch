From 43cfe71388fbf5c8b6973bc377e534d70d298fd4 Mon Sep 17 00:00:00 2001
From: Alexander Winkowski <dereference23@outlook.com>
Date: Mon, 8 Jan 2024 19:24:29 +0000
Subject: [PATCH 4/4] Make su domain permissive on user builds

Change-Id: I51543c86b3b5e45a1e10faff3d94bcb1dda709d2
Signed-off-by: Pranav Vashi <neobuddy89@gmail.com>
---
 Android.bp                       |  7 ++++++-
 build/soong/compat_cil.go        |  2 +-
 prebuilts/api/34.0/private/su.te | 10 +++++-----
 private/su.te                    | 10 +++++-----
 4 files changed, 17 insertions(+), 12 deletions(-)

diff --git a/Android.bp b/Android.bp
index 44210b901..b6559b841 100644
--- a/Android.bp
+++ b/Android.bp
@@ -704,7 +704,10 @@ precompiled_se_policy_binary {
     required: [
         "sepolicy_neverallows",
     ],
-    permissive_domains_on_user_builds: ["backuptool"],
+    permissive_domains_on_user_builds: [
+        "backuptool",
+        "su",
+    ],
 }
 
 // policy for recovery
@@ -742,6 +745,7 @@ se_policy_binary {
     permissive_domains_on_user_builds: [
         "backuptool",
         "recovery",
+        "su",
     ],
 }
 
@@ -797,6 +801,7 @@ se_policy_binary {
     dist: {
         targets: ["sepolicy_finalize"],
     },
+    permissive_domains_on_user_builds: ["su"],
 }
 
 se_policy_conf {
diff --git a/build/soong/compat_cil.go b/build/soong/compat_cil.go
index f68544b80..7570f511b 100644
--- a/build/soong/compat_cil.go
+++ b/build/soong/compat_cil.go
@@ -168,7 +168,7 @@ func (f *compatTestModule) createCompatTestModule(ctx android.LoadHookContext, v
 		Srcs:              srcs,
 		Ignore_neverallow: proptools.BoolPtr(true),
 		Installable:       proptools.BoolPtr(false),
-		Permissive_domains_on_user_builds: []string{"backuptool"},
+		Permissive_domains_on_user_builds: []string{"backuptool", "su"},
 	})
 }
 
diff --git a/prebuilts/api/34.0/private/su.te b/prebuilts/api/34.0/private/su.te
index cc00e103b..bac0ae0f7 100644
--- a/prebuilts/api/34.0/private/su.te
+++ b/prebuilts/api/34.0/private/su.te
@@ -1,6 +1,6 @@
-userdebug_or_eng(`
-  typeattribute su coredomain;
+typeattribute su coredomain;
 
+userdebug_or_eng(`
   domain_auto_trans(shell, su_exec, su)
   # Allow dumpstate to call su on userdebug / eng builds to collect
   # additional information.
@@ -22,9 +22,6 @@ userdebug_or_eng(`
   # Put the virtmgr command into its domain.
   domain_auto_trans(su, virtualizationmanager_exec, virtualizationmanager)
 
-  # su is also permissive to permit setenforce.
-  permissive su;
-
   app_domain(su)
 
   # Do not audit accesses to keystore2 namespace for the su domain.
@@ -33,3 +30,6 @@ userdebug_or_eng(`
   # Allow root to set MTE permissive mode.
   set_prop(su, permissive_mte_prop);
 ')
+
+# su is also permissive to permit setenforce.
+permissive su;
diff --git a/private/su.te b/private/su.te
index fae9b987e..690f305ff 100644
--- a/private/su.te
+++ b/private/su.te
@@ -1,6 +1,6 @@
-userdebug_or_eng(`
-  typeattribute su coredomain;
+typeattribute su coredomain;
 
+userdebug_or_eng(`
   domain_auto_trans(shell, su_exec, su)
   # Allow dumpstate to call su on userdebug / eng builds to collect
   # additional information.
@@ -23,9 +23,6 @@ userdebug_or_eng(`
   # own domain.
   virtualizationservice_use(su)
 
-  # su is also permissive to permit setenforce.
-  permissive su;
-
   app_domain(su)
 
   # Do not audit accesses to keystore2 namespace for the su domain.
@@ -135,3 +132,6 @@ userdebug_or_eng(`
   typeattribute su hal_wifi_hostapd_client;
   typeattribute su hal_wifi_supplicant_client;
 ')
+
+# su is also permissive to permit setenforce.
+permissive su;
-- 
2.52.0

