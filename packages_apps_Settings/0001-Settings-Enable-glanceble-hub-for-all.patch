From 8cdeda13381f46bc6215af6258aae7cb5655fd79 Mon Sep 17 00:00:00 2001
From: aswin7469 <aswinas@pixysos.com>
Date: Sun, 7 Dec 2025 02:55:09 +0530
Subject: [PATCH] Settings: Enable glanceble hub for all

---
 res/xml/security_lockscreen_settings.xml                    | 6 ++++++
 .../communal/WhenToStartHubPreferenceController.java        | 2 +-
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/res/xml/security_lockscreen_settings.xml b/res/xml/security_lockscreen_settings.xml
index f01013e0a49..7ea459d2468 100644
--- a/res/xml/security_lockscreen_settings.xml
+++ b/res/xml/security_lockscreen_settings.xml
@@ -42,6 +42,12 @@
             settings:searchable="false"
             settings:controller="com.android.settings.biometrics.face.FaceSettingsLockscreenBypassPreferenceController" />
 
+        <com.android.settingslib.PrimarySwitchPreference
+            android:key="widgets_on_lockscreen"
+            android:title="@string/widgets_on_lockscreen_title"
+            android:fragment="com.android.settings.communal.WidgetsOnLockscreenFragment"
+            settings:controller="com.android.settings.display.WidgetsOnLockscreenPreferenceController"/>
+
         <com.android.settingslib.RestrictedSwitchPreference
             android:key="security_lockscreen_add_users_when_locked"
             android:title="@string/user_add_on_lockscreen_menu"
diff --git a/src/com/android/settings/communal/WhenToStartHubPreferenceController.java b/src/com/android/settings/communal/WhenToStartHubPreferenceController.java
index c8aa89e3182..67931ee7f65 100644
--- a/src/com/android/settings/communal/WhenToStartHubPreferenceController.java
+++ b/src/com/android/settings/communal/WhenToStartHubPreferenceController.java
@@ -51,7 +51,7 @@ public void updateState(Preference preference) {
 
     @Override
     public int getAvailabilityStatus() {
-        return UNSUPPORTED_ON_DEVICE;
+        return AVAILABLE;
     }
 
     @Override
